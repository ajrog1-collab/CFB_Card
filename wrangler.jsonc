{
  // Tells Cloudflare this is a plain static site and where the files are.
  // No Worker script, no build step — it just serves the contents of /docs.
  "name": "thecard",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./docs"
    // No SPA fallback: this is one page with no client-side routing, and the
    // fallback made a missing data file return index.html, so fetch() got HTML
    // and reported a JSON parse error instead of a plain 404.
  }
}
